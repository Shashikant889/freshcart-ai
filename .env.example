# ==============================================================================
# FreshCart AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit your real .env file or production secrets to Git!
# ==============================================================================

# Node.js Server Configuration
PORT=3000
NODE_ENV=development

# Authentication & Security
# WARNING: Generate a secure 256-bit random string for production deployments.
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_minimum_32_chars

# Database Configuration
# Path to SQLite database file relative to project root
DB_PATH=db/freshcart.db

# Python AI / FastAPI Microservice (Optional - Node.js fallbacks active if offline)
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=8000
AI_TIMEOUT_MS=1500
AI_SERVICE_DEBUG=false
